# name: test/sql/garage.test
# description: test dicom extension (reading from cloud)
# group: [sql]

require-env RUN_LOCAL_S3_TESTS

require dicom

require httpfs

# =================== READ_DICOM from S3 ===================

statement ok
CREATE SECRET garage_secret (
    TYPE s3,
    PROVIDER config,
	ENDPOINT 'localhost:3900',
    KEY_ID 'GARAGEADMINACCESSKEY',
    SECRET 'garagetestingsecretkey',
	REGION 'garage',
	USE_SSL false,
	URL_STYLE 'path'
);

statement ok
FROM read_dicom("s3://dicom-test/test_dicom/**");
